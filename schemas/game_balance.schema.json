{
  "$defs": {
    "AudioDesignAndMixingConfig": {
      "additionalProperties": true,
      "description": "Audio bus hierarchy, loudness normalization, sidechain ducking, and harmonic pitch rules.",
      "properties": {
        "bus_hierarchy": {
          "description": "Ordered audio mixer bus list",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Bus Hierarchy",
          "type": "array"
        },
        "master_target_loudness_lufs": {
          "description": "Target master loudness in LUFS (typically -14.0)",
          "maximum": 0.0,
          "minimum": -30.0,
          "title": "Master Target Loudness Lufs",
          "type": "number"
        },
        "sidechain_ducking": {
          "$ref": "#/$defs/SidechainDuckingConfig"
        }
      },
      "required": [
        "bus_hierarchy",
        "master_target_loudness_lufs",
        "sidechain_ducking"
      ],
      "title": "AudioDesignAndMixingConfig",
      "type": "object"
    },
    "DifficultyProgressionCurves": {
      "additionalProperties": true,
      "description": "Mathematical progression formulas and concrete level milestones.",
      "properties": {
        "formulas": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Mathematical progression formulas (linear, exponential, or logarithmic)",
          "minProperties": 2,
          "title": "Formulas",
          "type": "object"
        },
        "level_milestones": {
          "description": "Concrete milestone evaluations across early, mid, and late game",
          "items": {
            "$ref": "#/$defs/LevelMilestone"
          },
          "minItems": 3,
          "title": "Level Milestones",
          "type": "array"
        }
      },
      "required": [
        "formulas",
        "level_milestones"
      ],
      "title": "DifficultyProgressionCurves",
      "type": "object"
    },
    "HitStopTierConfig": {
      "additionalProperties": true,
      "description": "Single hit-stop / freeze-frame tier specification.",
      "properties": {
        "duration_realtime_sec": {
          "description": "Real-time hit-stop duration in seconds (0ms to 500ms)",
          "maximum": 0.5,
          "minimum": 0.0,
          "title": "Duration Realtime Sec",
          "type": "number"
        },
        "time_scale": {
          "description": "Engine time scale during hit-stop (0.0 = full freeze, 1.0 = normal speed)",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Time Scale",
          "type": "number"
        },
        "tanim_tr": {
          "description": "Explanation of when this hit-stop tier triggers",
          "minLength": 3,
          "title": "Tanim Tr",
          "type": "string"
        }
      },
      "required": [
        "duration_realtime_sec",
        "time_scale",
        "tanim_tr"
      ],
      "title": "HitStopTierConfig",
      "type": "object"
    },
    "JuiceAndGameFeelMatrix": {
      "additionalProperties": true,
      "description": "Complete quantified 2D Game Feel & Juice choreography matrix.",
      "properties": {
        "screen_shake_trauma": {
          "$ref": "#/$defs/ScreenShakeTraumaConfig"
        },
        "hit_stop_freeze_frames": {
          "additionalProperties": {
            "$ref": "#/$defs/HitStopTierConfig"
          },
          "description": "Multi-tier hit-stop freeze frame definitions",
          "minProperties": 2,
          "title": "Hit Stop Freeze Frames",
          "type": "object"
        },
        "squash_and_stretch": {
          "$ref": "#/$defs/SquashAndStretchConfig"
        },
        "particle_choreography": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "description": "Particle burst emission definitions per gameplay event",
          "minProperties": 1,
          "title": "Particle Choreography",
          "type": "object"
        },
        "audio_design_and_mixing": {
          "$ref": "#/$defs/AudioDesignAndMixingConfig"
        }
      },
      "required": [
        "screen_shake_trauma",
        "hit_stop_freeze_frames",
        "squash_and_stretch",
        "particle_choreography",
        "audio_design_and_mixing"
      ],
      "title": "JuiceAndGameFeelMatrix",
      "type": "object"
    },
    "LevelMilestone": {
      "additionalProperties": true,
      "description": "Quantified level milestone snapshot along the difficulty progression curve.",
      "properties": {
        "level": {
          "description": "Milestone level number (>= 1)",
          "minimum": 1,
          "title": "Level",
          "type": "integer"
        },
        "tanim_tr": {
          "description": "Design description of the level milestone",
          "minLength": 5,
          "title": "Tanim Tr",
          "type": "string"
        }
      },
      "required": [
        "level",
        "tanim_tr"
      ],
      "title": "LevelMilestone",
      "type": "object"
    },
    "MetaConfig": {
      "additionalProperties": true,
      "description": "Metadata identifying the analyzed 2D game concept and balance model.",
      "properties": {
        "oyun_adi": {
          "description": "Analyzed game concept title",
          "minLength": 2,
          "title": "Oyun Adi",
          "type": "string"
        },
        "surum": {
          "default": "1.0.0",
          "description": "Semantic version of the balance config",
          "title": "Surum",
          "type": "string"
        },
        "tur": {
          "description": "2D Hyper-Casual / Hybrid-Casual sub-genre description",
          "minLength": 5,
          "title": "Tur",
          "type": "string"
        },
        "tasarim_lideri": {
          "default": "Autonomous Game Design, Market & Thinking Lead",
          "description": "Authoring agent role",
          "title": "Tasarim Lideri",
          "type": "string"
        },
        "denge_modeli": {
          "description": "Primary mathematical balance model summary",
          "minLength": 5,
          "title": "Denge Modeli",
          "type": "string"
        },
        "tarih": {
          "description": "ISO date (YYYY-MM-DD)",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Tarih",
          "type": "string"
        },
        "aciklama": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Context description of the balance configuration",
          "title": "Aciklama"
        }
      },
      "required": [
        "oyun_adi",
        "tur",
        "denge_modeli",
        "tarih"
      ],
      "title": "MetaConfig",
      "type": "object"
    },
    "PhysicsAndCollisionTuning": {
      "additionalProperties": true,
      "description": "Container for core 2D physics simulation and concept-specific collision rules.",
      "properties": {
        "simulation": {
          "$ref": "#/$defs/PhysicsSimulationConfig"
        }
      },
      "required": [
        "simulation"
      ],
      "title": "PhysicsAndCollisionTuning",
      "type": "object"
    },
    "PhysicsSimulationConfig": {
      "additionalProperties": true,
      "description": "Engine-neutral 2D physics simulation parameters (`physics-tuning` discipline).",
      "properties": {
        "fixed_timestep_sec": {
          "description": "Fixed physics step in seconds (e.g. 0.01666 for 60Hz)",
          "exclusiveMinimum": 0.0,
          "maximum": 0.05,
          "title": "Fixed Timestep Sec",
          "type": "number"
        },
        "physics_hz": {
          "description": "Simulation tick rate in Hz",
          "maximum": 240,
          "minimum": 30,
          "title": "Physics Hz",
          "type": "integer"
        },
        "continuous_collision_detection": {
          "description": "Whether CCD is enabled to prevent fast-body tunneling",
          "title": "Continuous Collision Detection",
          "type": "boolean"
        },
        "render_interpolation": {
          "default": true,
          "description": "Whether visual interpolation is enabled between physics ticks",
          "title": "Render Interpolation",
          "type": "boolean"
        },
        "gravity_scale": {
          "description": "Gravity multiplier",
          "maximum": 10.0,
          "minimum": -10.0,
          "title": "Gravity Scale",
          "type": "number"
        },
        "linear_drag": {
          "description": "Linear velocity damping",
          "maximum": 50.0,
          "minimum": 0.0,
          "title": "Linear Drag",
          "type": "number"
        },
        "restitution_bounciness": {
          "description": "Collision elasticity / bounciness coefficient",
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Restitution Bounciness",
          "type": "number"
        },
        "friction": {
          "description": "Surface friction coefficient",
          "maximum": 5.0,
          "minimum": 0.0,
          "title": "Friction",
          "type": "number"
        }
      },
      "required": [
        "fixed_timestep_sec",
        "physics_hz",
        "continuous_collision_detection",
        "gravity_scale",
        "linear_drag",
        "restitution_bounciness",
        "friction"
      ],
      "title": "PhysicsSimulationConfig",
      "type": "object"
    },
    "ScoringAndComboEconomy": {
      "additionalProperties": true,
      "description": "Scoring rewards and combo escalation window parameters.",
      "properties": {
        "combo_multiplier_step": {
          "description": "Multiplier increment per combo step",
          "exclusiveMinimum": 0.0,
          "maximum": 5.0,
          "title": "Combo Multiplier Step",
          "type": "number"
        },
        "max_combo_multiplier": {
          "description": "Maximum cap on combo multiplier",
          "exclusiveMinimum": 1.0,
          "maximum": 100.0,
          "title": "Max Combo Multiplier",
          "type": "number"
        }
      },
      "required": [
        "combo_multiplier_step",
        "max_combo_multiplier"
      ],
      "title": "ScoringAndComboEconomy",
      "type": "object"
    },
    "ScreenShakeTraumaConfig": {
      "additionalProperties": true,
      "description": "Quadratic camera trauma model (`Shake = Trauma^2`).",
      "properties": {
        "model": {
          "description": "Mathematical screen shake model specification",
          "minLength": 5,
          "title": "Model",
          "type": "string"
        },
        "trauma_decay_per_sec": {
          "description": "Linear trauma decay rate per second",
          "exclusiveMinimum": 0.0,
          "maximum": 10.0,
          "title": "Trauma Decay Per Sec",
          "type": "number"
        },
        "max_offset_pixels": {
          "description": "Maximum [X, Y] translational camera shake offset in pixels",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Max Offset Pixels",
          "type": "array"
        },
        "max_rotation_radians": {
          "description": "Maximum rotational shake angle in radians",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Max Rotation Radians",
          "type": "number"
        },
        "noise_frequency_hz": {
          "description": "Perlin/Simplex or sinusoidal shake frequency in Hz",
          "exclusiveMinimum": 0.0,
          "maximum": 120.0,
          "title": "Noise Frequency Hz",
          "type": "number"
        },
        "event_trauma_increments": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Normalized trauma increments [0.0 - 1.0] added per gameplay event",
          "minProperties": 2,
          "title": "Event Trauma Increments",
          "type": "object"
        }
      },
      "required": [
        "model",
        "trauma_decay_per_sec",
        "max_offset_pixels",
        "max_rotation_radians",
        "noise_frequency_hz",
        "event_trauma_increments"
      ],
      "title": "ScreenShakeTraumaConfig",
      "type": "object"
    },
    "SidechainDuckingConfig": {
      "additionalProperties": true,
      "description": "Audio bus sidechain ducking parameters (`audio-design` discipline).",
      "properties": {
        "trigger_bus": {
          "description": "Bus that triggers ducking (e.g. SFX_Glass, SFX_Impacts)",
          "minLength": 2,
          "title": "Trigger Bus",
          "type": "string"
        },
        "target_bus": {
          "description": "Bus being ducked (e.g. Music)",
          "minLength": 2,
          "title": "Target Bus",
          "type": "string"
        },
        "duck_gain_db": {
          "description": "Gain reduction in dB (must be negative)",
          "exclusiveMaximum": 0.0,
          "minimum": -48.0,
          "title": "Duck Gain Db",
          "type": "number"
        },
        "attack_ms": {
          "description": "Ducking attack time in milliseconds",
          "exclusiveMinimum": 0.0,
          "maximum": 500.0,
          "title": "Attack Ms",
          "type": "number"
        },
        "release_ms": {
          "description": "Ducking release time in milliseconds",
          "exclusiveMinimum": 0.0,
          "maximum": 2000.0,
          "title": "Release Ms",
          "type": "number"
        }
      },
      "required": [
        "trigger_bus",
        "target_bus",
        "duck_gain_db",
        "attack_ms",
        "release_ms"
      ],
      "title": "SidechainDuckingConfig",
      "type": "object"
    },
    "SquashAndStretchConfig": {
      "additionalProperties": true,
      "description": "Squash & Stretch deformation vectors and tween restoration curves.",
      "properties": {
        "tween_ease_type": {
          "description": "Easing function name (e.g. EaseOutBack, EaseOutElastic)",
          "minLength": 3,
          "title": "Tween Ease Type",
          "type": "string"
        },
        "tween_restore_duration_sec": {
          "description": "Duration to restore scale to [1.0, 1.0] in seconds",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Tween Restore Duration Sec",
          "type": "number"
        }
      },
      "required": [
        "tween_ease_type",
        "tween_restore_duration_sec"
      ],
      "title": "SquashAndStretchConfig",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "Root Pydantic Data Contract for `game_balance.json`.\n\nValidates all mandatory studio pipeline sections while allowing concept-specific\nmechanic blocks (e.g., `player_sling_and_pulse_mechanics`, `slicing_mechanics`,\n`sorting_grid_mechanics`) via structured dictionary validation.",
  "properties": {
    "meta": {
      "$ref": "#/$defs/MetaConfig"
    },
    "physics_and_collision_tuning": {
      "$ref": "#/$defs/PhysicsAndCollisionTuning"
    },
    "difficulty_progression_curves": {
      "$ref": "#/$defs/DifficultyProgressionCurves"
    },
    "juice_and_game_feel_matrix": {
      "$ref": "#/$defs/JuiceAndGameFeelMatrix"
    },
    "scoring_and_combo_economy": {
      "$ref": "#/$defs/ScoringAndComboEconomy"
    }
  },
  "required": [
    "meta",
    "physics_and_collision_tuning",
    "difficulty_progression_curves",
    "juice_and_game_feel_matrix",
    "scoring_and_combo_economy"
  ],
  "title": "GameBalanceConfig",
  "type": "object"
}
